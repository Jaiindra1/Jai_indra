{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "regions": ["bom1"],
  "buildCommand": "python scripts/build_browser.py",
  "functions": {
    "main.py": {
      "maxDuration": 120,
      "includeFiles": "{templates/**,vendor/browser.tar.gz,vendor/browser-manifest.json,vendor/pagination.key}",
      "excludeFiles": "{tests/**,.browser-downloads/**,scripts/**}"
    }
  }
}
